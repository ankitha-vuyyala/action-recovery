# Copy this file to .env and fill in the values you have.
# .env is git-ignored. Never commit it, paste it, or print its values.
# Leave a line empty if you do not have that key; the code checks presence only.

# --- Model provider (all model calls in this study use OpenAI) ------------
OPENAI_API_KEY=

# --- Spending guard (enforced in code; the run stops before exceeding it) ---
# Hard cap in US dollars for all paid model calls across the whole project.
MAX_SPEND_USD=6
# Cap for a single run invocation (pilot, main run, ...).
MAX_SPEND_PER_RUN_USD=6

# --- Local Docker services (only reachable on this machine) -----------------
# Any random strings are fine; they never leave your computer.
POSTGRES_PASSWORD=
GITEA_ADMIN_PASSWORD=
MINIO_ROOT_USER=actrec
MINIO_ROOT_PASSWORD=
